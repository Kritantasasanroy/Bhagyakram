# Copy this to .env and fill in your key. Never commit .env.

# Groq API key — get a free key at https://console.groq.com
# To use multiple keys for load balancing / rate-limit rotation, either:
#   Option A (comma-separated):  GROQ_API_KEY=key1,key2,key3
#   Option B (numbered vars, handy for HF Spaces secrets):
#     GROQ_API_KEY=key1
#     GROQ_API_KEY_2=key2
#     GROQ_API_KEY_3=key3
# On a 429 the agent automatically rotates to the next key.
GROQ_API_KEY=your_groq_key_here

# Groq models (defaults work well, only override if needed):
#   llama-3.3-70b-versatile  <- default: best quality
#   llama-3.1-8b-instant     <- used for editor node (fast tone edits)
LLM_MODEL=llama-3.3-70b-versatile

# Model used by the LLM-as-judge in the eval harness
JUDGE_MODEL=llama-3.3-70b-versatile

